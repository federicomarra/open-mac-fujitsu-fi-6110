/* Tutorial window */
"tutorial.title" = "Come usare fi-6110 Scanner";
"tutorial.intro" = "Questa guida ti mostra passo dopo passo come digitalizzare i tuoi documenti con lo scanner Fujitsu fi-6110.";
"tut.connect.t" = "Collega lo scanner";
"tut.connect.b" = "Collega lo scanner al Mac con il cavo USB e accendilo. Quando in alto a destra il pallino diventa verde, lo scanner è pronto. Se resta arancione, controlla il cavo e che sia acceso, poi attendi qualche secondo.";
"tut.load.t" = "Inserisci i fogli";
"tut.load.b" = "Metti i fogli nell'alimentatore automatico, con il testo rivolto verso di te e il bordo superiore in basso. Puoi caricare più fogli insieme: verranno acquisiti uno dopo l'altro.";
"tut.options.t" = "Scegli le opzioni";
"tut.options.b" = "A destra scegli il tipo (colore, scala di grigi o bianco e nero), la risoluzione in dpi (più alta significa più dettaglio ma file più grandi) e le dimensioni del foglio. Attiva «Fronte-retro» per acquisire entrambi i lati in un solo passaggio.";
"tut.format.t" = "Scegli il formato del file";
"tut.format.b" = "«PDF» crea un unico documento con tutte le pagine. «PDF (ricercabile)» aggiunge il riconoscimento del testo, così potrai cercare e copiare le parole nel documento. JPEG, PNG e TIFF creano invece un'immagine per ogni pagina.";
"tut.extras.t" = "Opzioni utili";
"tut.extras.b" = "«Ruota automaticamente le pagine» riconosce un foglio inserito sottosopra e lo gira nel verso giusto. «Raddrizza automaticamente le pagine» corregge i fogli entrati un po' storti. «Salta le pagine vuote» elimina i retro bianchi quando acquisisci in fronte-retro.";
"tut.arrange.t" = "Riordina le pagine";
"tut.arrange.b" = "Dopo la scansione puoi trascinare le pagine per cambiarne l'ordine, oppure premere «Inverti ordine» per invertirlo. «Capovolgi tutte» gira di 180° tutte le pagine insieme. Un doppio clic su una pagina la ruota di 180°; con il tasto destro puoi ruotarla a destra, a sinistra, capovolgerla oppure eliminarla (l'app chiede conferma). Il file salvato viene aggiornato automaticamente.";
"tut.append.t" = "Aggiungi le scansioni a un PDF esistente";
"tut.append.b" = "Vuoi aggiungere dei fogli a un PDF che hai già? Premi «Aggiungi a un PDF» a destra (o il pulsante nella schermata iniziale) e scegli il documento: le sue pagine appaiono nella finestra con il contrassegno PDF, e i fogli che acquisisci vengono aggiunti in fondo. Le pagine del documento originale restano intatte, con il loro testo. L'app salva il risultato sul PDF che hai scelto: se non vuoi sostituirlo, togli la spunta a «Sovrascrivi il file se esiste già» e verrà creato un file nuovo. Premendo di nuovo «Scansiona» l'app ti chiede se aggiungere i nuovi fogli in fondo o rifare la scansione. Con un PDF caricato i due pulsanti in alto agiscono solo sulle pagine appena scansionate: quelle del documento originale non si spostano e non si girano. Se vuoi girare una singola pagina del PDF puoi comunque farlo con il doppio clic o il tasto destro.";
"tut.save.t" = "Dove finiscono i file";
"tut.save.b" = "In «Salva in» scegli la cartella (di solito Documenti). In «Nome» c'è già la data di oggi: puoi cambiarla come preferisci. Se esiste già un file con lo stesso nome, ne viene creato uno nuovo aggiungendo -1, -2… senza sovrascrivere quello vecchio. Attiva «Sovrascrivi il file se esiste già» se invece preferisci sostituirlo.";
"tut.defaults.t" = "Imposta i tuoi valori predefiniti";
"tut.defaults.b" = "Dal menu «fi-6110 Scanner ▸ Impostazioni…» (⌘,) puoi decidere le opzioni che vuoi trovare già pronte ogni volta che apri l'app: tipo, risoluzione, fronte-retro, formato e altro.";
"tut.trouble.t" = "Se qualcosa non va";
"tut.trouble.b" = "«Scanner non trovato»: controlla il cavo USB e che lo scanner sia acceso. «Carta inceppata»: apri lo scanner, togli i fogli e riprova. Ricorda di mettere i fogli nell'alimentatore prima di premere «Scansiona».";
